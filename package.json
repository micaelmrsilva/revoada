{
  "name": "revoada",
  "private": true,
  "version": "1.2.0",
  "description": "App para macOS que roda várias contas de agentes de código num lugar só, com rodízio que leva a conversa",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "app": "scripts/build-app.sh",
    "app:install": "bun test && scripts/build-app.sh --install",
    "app:zip": "scripts/build-app.sh --zip",
    "test": "bun test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "license": "MIT"
}